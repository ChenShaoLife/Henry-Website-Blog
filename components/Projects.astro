---
import { strings, projects, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = strings[lang];
const list = projects[lang];
---
<section id="projects" class="section">
  <div class="wrap">
    <div class="sec-row rv">
      <h2 class="sec-h" set:html={t.sections.projectsHtml}></h2>
      <div class="scroll-btns">
        <button class="scroll-btn" id="projects-prev" aria-label={t.sections.prevAria}>←</button>
        <button class="scroll-btn" id="projects-next" aria-label={t.sections.nextAria}>→</button>
      </div>
    </div>

    <div class="h-scroll rv d1" id="projects-scroll">
      {list.map((p) => (
        <article class="card pj-card">
          <div class="pj-inner">
            <span class="pj-num">{p.num}</span>
            <h3 class="pj-name">{p.name}</h3>
            <p class="pj-quote">{p.desc}</p>
            <div class="pj-footer">
              <p class="pj-date">{p.date}</p>
              <a href={p.url} class="pj-link-icon" target="_blank" rel="noopener" aria-label="View Product">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
