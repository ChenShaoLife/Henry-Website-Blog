---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blogZh', ({ data }) => !data.draft || import.meta.env.DEV);
  const enPosts = await getCollection('blogEn', ({ data }) => !data.draft || import.meta.env.DEV);
  const enIds = new Set(enPosts.map((p) => p.id));
  posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  return posts.map((post, i) => {
    const next = i > 0 ? { id: posts[i - 1].id, title: posts[i - 1].data.title } : null;
    const prev = i < posts.length - 1 ? { id: posts[i + 1].id, title: posts[i + 1].data.title } : null;
    const langHref = enIds.has(post.id) ? undefined : '/blog/';
    return { params: { slug: post.id }, props: { post, prev, next, langHref } };
  });
}

const { post, prev, next, langHref } = Astro.props;
const { Content } = await render(post);
const readingTime = Math.max(1, Math.ceil(post.body.replace(/[^一-龥]/g, '').length / 400));
---
<BlogPost
  lang="zh"
  currentId={post.id}
  langHref={langHref}
  readingTime={readingTime}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  cover={post.data.cover}
  prev={prev}
  next={next}
>
  <Content />
</BlogPost>
