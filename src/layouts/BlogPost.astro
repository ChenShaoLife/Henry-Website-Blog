  }
  .post-tag:hover { transform: translate(-1px,-1px); box-shadow: 2px 2px 0 var(--text); }
  .post-title {
    font-family: var(--fh);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 800; letter-spacing: -0.02em;
    line-height: 1.15; margin-bottom: 14px;
  }
  .post-desc { font-size: 17px; color: var(--muted); line-height: 1.6; }

  .post-back-wrap { max-width: 880px; margin: 48px auto 80px; padding: 0 24px; text-align: center; }
