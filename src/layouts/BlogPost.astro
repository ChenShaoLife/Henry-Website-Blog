---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrevNext from '../components/PrevNext.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Giscus from '../components/Giscus.astro';
import { strings, type Lang } from '../i18n/strings';

interface Adj { id: string; title: string; }
interface Props {
  lang: Lang;
  currentId: string;
  title: string;
  description: string;
  pubDate: Dat
  tags: string[];
  cover?: string;
  prev?: Adj | null;
  next?: Adj | null;
  langHref?: string;
  readingTime: number;
}
const { lang, currentId, title, description, pubDate, tags, cover, prev, next, langHref, readingTime } = Astro.props;
const t = strings[lang];
const dateLabel = pubDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const urlBase = lang === 'en' ? '/blog' : '/zh/blog';
---
<BaseLayout
  lang={lang}
  langHref={langHref}
  pageTitle={title}
  pageDescription={description}
  pageImage={cover}
  pageType="article"
  pubDate={pubDate}
>
  <article class="post-wrap">
    <div class="post-card">
      {cover && <img class="post-cover" src={cover} alt={title} />}
      <div class="post-body">
        <header class="post-head">
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>{dateLabel}</time>
            <span class="post-reading">{readingTime} {t.blog.readingMin}</span>
            {tags.length > 0 && (
              <span class="post-tags">
                {tags.map((tag) => (
                  <a class="post-tag" href={`${urlBase}/tag/${encodeURIComponent(tag)}`}>{tag}</a>
                ))}
              </span>
            )}
          </div>
          <h1 class="post-title">{title}</h1>
          <p class="post-desc">{description}</p>
        </header>
        <div class="post-content">
          <slot />
        </div>
      </div>
    </div>
  </article>

  {/* Share section */}
  <div class="sh-wrap"
    data-title={title}
    data-desc={description}
    data-cover={cover ?? ''}
    data-url={new URL(Astro.url.pathname, Astro.site ?? 'https://henry-website-seven.vercel.app').href}
    data-site={lang === 'zh' ? 'Henry 的博客' : "Henry's Blog"}
    data-site-url="henry-website-seven.vercel.app"
    data-tags={tags.slice(0, 2).join(' · ')}
    data-author="Henry"
    data-scan={t.blog.shareCardScan}
    data-dl={t.blog.shareCardDl}
    data-close={t.blog.shareCardClose}
  >
    <span class="sh-label">{t.blog.shareLabel}</span>
    <button class="sh-btn" id="sh-copy">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      {t.blog.shareCopy}
    </button>
    <a class="sh-btn" id="sh-wa" href="#" target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      WhatsApp
    </a>
    <a class="sh-btn" id="sh-tw" href="#" target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      X
    </a>
    <button class="sh-btn sh-btn-card" id="sh-card">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span id="sh-card-label">{t.blog.shareCard}</span>
    </button>
  </div>

  {/* Share card modal */}
  <div class="sc-bg" id="sc-bg" role="dialog" aria-modal="true" aria-hidden="true" aria-label={t.blog.shareCard}>
    <div class="sc-modal">
      <canvas class="sc-canvas" id="sc-canvas"></canvas>
      <div class="sc-actions">
        <button class="sc-dl-btn" id="sc-dl"></button>
        <button class="sc-close" id="sc-close"></button>
      </div>
    </div>
  </div>

  <RelatedArticles lang={lang} currentId={currentId} tags={tags} />
  <PrevNext lang={lang} prev={prev} next={next} />
  <Giscus lang={lang} />

  <div id="post-toast" class="post-toast" aria-live="polite"></div>

  <div id="lb" class="lb" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lb-close" id="lb-close" aria-label={t.blog.lbClose}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lb-arrow lb-prev" id="lb-prev" aria-label={t.blog.lbPrev}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="lb-frame" id="lb-frame">
      <img class="lb-img" id="lb-img" src="" alt="" draggable="false" />
    </div>
    <button class="lb-arrow lb-next" id="lb-next" aria-label={t.blog.lbNext}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lb-counter" id="lb-counter"></div>
    <div class="lb-zoom-hint" id="lb-zoom-hint"></div>
  </div>

  <script>
    const isZh = document.documentElement.lang.startsWith('zh');
    const UI = {
      copy:      isZh ? '复制'        : 'Copy',
      copied:    isZh ? '已复制'       : 'Copied',
      copyAriaCode: isZh ? '复制代码'  : 'Copy code',
      toastCode: isZh ? '代码已复制 ✓' : 'Code copied ✓',
      toastText: isZh ? '已复制 ✓'    : 'Copied ✓',
      attr: isZh
        ? '\n\n—— 出自 Henry 的博客：https://henry-website-seven.vercel.app'
        : '\n\nSource: Henry\'s Blog — https://henry-website-seven.vercel.app',
    };

    let _toastTimer: ReturnType<typeof setTimeout> | null = null;
    function showToast(msg: string) {
      const el = document.getElementById('post-toast') as HTMLElement;
      if (!el) return;
      el.textContent = msg;
      el.classList.add('show');
      if (_toastTimer) clearTimeout(_toastTimer);
      _toastTimer = setTimeout(() => el.classList.remove('show'), 2000);
    }

    function enhanceCodeBlocks() {
      const COPY_ICON = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const OK_ICON = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

      document.querySelectorAll('.post-content pre').forEach((pre) => {
        if ((pre as HTMLElement).dataset.enhanced) return;
        (pre as HTMLElement).dataset.enhanced = '1';
        const lang = (pre as HTMLElement).dataset.language;
        if (lang && lang !== 'text' && lang !== 'plaintext') {
          const badge = document.createElement('span');
          badge.className = 'code-lang';
          badge.textContent = lang;
          pre.appendChild(badge);
        }
        const btn = document.createElement('button');
        btn.className = 'code-copy';
        btn.type = 'button';
        btn.setAttribute('aria-label', UI.copyAriaCode);
        btn.innerHTML = COPY_ICON + `<span>${UI.copy}</span>`;
        btn.addEventListener('click', async () => {
          const codeEl = pre.querySelector('code');
          const text = (codeEl as HTMLElement)?.innerText || (pre as HTMLElement).innerText;
          try {
            await navigator.clipboard.writeText(text + UI.attr);
            btn.classList.add('ok');
            btn.innerHTML = OK_ICON + `<span>${UI.copied}</span>`;
            showToast(UI.toastCode);
            setTimeout(() => {
              btn.classList.remove('ok');
              btn.innerHTML = COPY_ICON + `<span>${UI.copy}</span>`;
            }, 1500);
          } catch {}
        });
        pre.appendChild(btn);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhanceCodeBlocks);
    } else {
      enhanceCodeBlocks();
    }

    // 复制拦截：普通文本选择自动附加来源
    document.addEventListener('copy', (e) => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed) return;
      const postContent = document.querySelector('.post-content');
      if (!postContent) return;
      try {
        const range = sel.getRangeAt(0);
        if (!postContent.contains(range.commonAncestorContainer)) return;
      } catch { return; }
      const selected = sel.toString().trim();
      if (!selected) return;
      e.clipboardData!.setData('text/plain', selected + UI.attr);
      e.preventDefault();
      showToast(UI.toastText);
    });

    // ── Share ──
    (function () {
      const wrap = document.querySelector('.sh-wrap') as HTMLElement;
      if (!wrap) return;
      const D = wrap.dataset;
      const articleUrl   = D.url!;
      const articleTitle = D.title!;
      const articleDesc  = D.desc!;
      const coverSrc     = D.cover!;
      const siteName     = D.site!;
      const siteUrl      = D.siteUrl!;
      const articleTags  = D.tags!;
      const articleAuthor = D.author!;
      const lblScan      = D.scan!;
      const lblDl        = D.dl!;
      const lblClose     = D.close!;

      // Platform links
      const wa = document.getElementById('sh-wa') as HTMLAnchorElement;
      const tw = document.getElementById('sh-tw') as HTMLAnchorElement;
      if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(articleTitle + '\n' + articleUrl)}`;
      if (tw) tw.href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(articleUrl)}&text=${encodeURIComponent(articleTitle)}`;

      // Copy link
      document.getElementById('sh-copy')?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(articleUrl); showToast(isZh ? '链接已复制 ✓' : 'Link copied ✓'); }
        catch { showToast(isZh ? '复制失败' : 'Failed'); }
      });

      // Share card
      let drawing = false;
      let drawn = false;
      document.getElementById('sh-card')?.addEventListener('click', openCard);
      document.getElementById('sc-close')?.addEventListener('click', closeCard);
      document.getElementById('sc-bg')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeCard(); });
      document.getElementById('sc-dl')?.addEventListener('click', downloadCard);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.getElementById('sc-bg')?.classList.contains('open')) closeCard();
      });

      function closeCard() {
        const bg = document.getElementById('sc-bg');
        bg?.classList.remove('open');
        bg?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      async function openCard() {
        if (drawing) return;
        const bg = document.getElementById('sc-bg');
        const dlBtn = document.getElementById('sc-dl');
        const closeBtn = document.getElementById('sc-close');
        const cardLabel = document.getElementById('sh-card-label');
        if (dlBtn)    { dlBtn.textContent = lblDl; }
        if (closeBtn) { closeBtn.textContent = lblClose; }
        if (!drawn) {
          drawing = true;
          const cardBtn = document.getElementById('sh-card') as HTMLButtonElement;
          const origLabel = cardLabel?.textContent ?? '';
          if (cardLabel) cardLabel.textContent = isZh ? '生成中…' : 'Loading…';
          if (cardBtn) cardBtn.disabled = true;
          try {
            await drawCard();
            drawn = true;
          } finally {
            drawing = false;
            if (cardLabel) cardLabel.textContent = origLabel;
            if (cardBtn) cardBtn.disabled = false;
          }
        }
        bg?.classList.add('open');
        bg?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      async function drawCard() {
        const canvas = document.getElementById('sc-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        const SHADOW = 12;
        const RC = 20;
        const CW = 750;
        const W = CW - SHADOW;
        const BORDER = '#0A0A0A';
        const BLUE   = '#5B9CF6';
        const PAD = 52;
        const coverH = 470;
        const BW = 3;

        // Pre-measure text to compute exact canvas height
        const DPR = window.devicePixelRatio || 1;
        canvas.width = CW; canvas.height = 1400;
        const ctx = canvas.getContext('2d')!;
        ctx.font = '800 34px "Space Grotesk", sans-serif';
        const _tl = wrapText(ctx, articleTitle, W - PAD * 2);
        let _ty = coverH + 42 + 56 + Math.min(_tl.length, 2) * 46;
        ctx.font = '400 23px Inter, sans-serif';
        const _dl = wrapText(ctx, articleDesc, W - PAD * 2);
        const _dy = _ty + 78 + Math.min(_dl.length, 3) * 36;
        const _scanY = _dy + 40 + 24 + Math.max(82, 100) + 40;
        const CH = _scanY + 48 + SHADOW;
        const H = CH - SHADOW;
        canvas.width = CW * DPR; canvas.height = CH * DPR;
        ctx.scale(DPR, DPR);

        function rr(x: number, y: number, w: number, h: number, r: number) {
          ctx.beginPath();
          ctx.moveTo(x + r, y);
          ctx.lineTo(x + w - r, y); ctx.arcTo(x + w, y, x + w, y + r, r);
          ctx.lineTo(x + w, y + h - r); ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
          ctx.lineTo(x + r, y + h); ctx.arcTo(x, y + h, x, y + h - r, r);
          ctx.lineTo(x, y + r); ctx.arcTo(x, y, x + r, y, r);
          ctx.closePath();
        }

        // ── Hard shadow (rounded) ──
        ctx.fillStyle = BORDER;
        rr(SHADOW, SHADOW, W, H, RC); ctx.fill();

        // ── Card background (rounded) ──
        ctx.fillStyle = '#FAFAFA';
        rr(0, 0, W, H, RC); ctx.fill();
        ctx.strokeStyle = BORDER; ctx.lineWidth = BW;
        rr(0, 0, W, H, RC); ctx.stroke();

        // ── Cover image (clip with rounded top corners) ──
        ctx.save();
        ctx.beginPath();
        ctx.moveTo(RC, BW / 2);
        ctx.lineTo(W - RC, BW / 2); ctx.arcTo(W - BW/2, BW/2, W - BW/2, RC, RC);
        ctx.lineTo(W - BW/2, coverH);
        ctx.lineTo(BW/2, coverH);
        ctx.lineTo(BW/2, RC); ctx.arcTo(BW/2, BW/2, RC, BW/2, RC);
        ctx.closePath(); ctx.clip();
        if (coverSrc) {
          try {
            const img = await loadImg(coverSrc);
            const s = Math.max(W / img.naturalWidth, coverH / img.naturalHeight);
            const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
            ctx.drawImage(img, (W - dw) / 2, (coverH - dh) / 2, dw, dh);
          } catch { drawFallbackBg(ctx, W, coverH); }
        } else { drawFallbackBg(ctx, W, coverH); }
        ctx.restore();
        // Black border below cover
        ctx.strokeStyle = BORDER; ctx.lineWidth = BW;
        ctx.beginPath(); ctx.moveTo(0, coverH); ctx.lineTo(W, coverH); ctx.stroke();

        // ── Tags (blue pill badges) ──
        const tags = articleTags ? articleTags.split(' · ').filter(Boolean) : [];
        let tagX = PAD;
        const tagY = coverH + 42;
        ctx.font = '700 22px "Space Grotesk", sans-serif';
        tags.slice(0, 3).forEach(tag => {
          const tagW = ctx.measureText(tag).width;
          const pw = tagW + 28, ph = 36;
          // Fill blue
          ctx.fillStyle = BLUE;
          ctx.beginPath(); ctx.roundRect(tagX, tagY - 26, pw, ph, ph / 2); ctx.fill();
          // Black border
          ctx.strokeStyle = BORDER; ctx.lineWidth = 2;
          ctx.stroke();
          // White text
          ctx.fillStyle = '#fff';
          ctx.fillText(tag, tagX + 14, tagY);
          tagX += pw + 10;
        });

        // ── Title ──
        ctx.font = '800 34px "Space Grotesk", sans-serif';
        const titleLines = _tl;
        let ty = tagY + 56;
        ctx.fillStyle = BORDER;
        titleLines.slice(0, 2).forEach(ln => { ctx.fillText(ln, PAD, ty); ty += 46; });

        // ── Author meta (blue pill, white text, vertically centered) ──
        const metaText = isZh ? `作者：${articleAuthor}` : `By ${articleAuthor}`;
        ctx.font = '600 24px Inter, sans-serif';
        const mw = ctx.measureText(metaText).width + 28;
        const pillH = 38, pillTop = ty + 4;
        ctx.fillStyle = BLUE;
        ctx.beginPath(); ctx.roundRect(PAD, pillTop, mw, pillH, pillH / 2); ctx.fill();
        ctx.strokeStyle = BORDER; ctx.lineWidth = 2; ctx.stroke();
        ctx.fillStyle = '#fff';
        ctx.fillText(metaText, PAD + 14, pillTop + pillH / 2 + 9);

        // ── Description ──
        ctx.fillStyle = '#666';
        ctx.font = '400 23px Inter, sans-serif';
        const descLines = _dl;
        let dy = ty + 78;
        descLines.slice(0, 3).forEach(ln => { ctx.fillText(ln, PAD, dy); dy += 36; });

        // ── Dashed separator (site style) ──
        const divY = dy + 40;
        ctx.save();
        ctx.setLineDash([10, 8]);
        ctx.strokeStyle = BORDER; ctx.lineWidth = 2.5;
        ctx.beginPath(); ctx.moveTo(PAD, divY); ctx.lineTo(W - PAD, divY); ctx.stroke();
        ctx.restore();

        // ── Footer ──
        const footY = divY + 24;
        const logoS = 82;

        // Blue logo square with black border
        ctx.fillStyle = BLUE;
        ctx.strokeStyle = BORDER; ctx.lineWidth = BW;
        ctx.beginPath(); ctx.rect(PAD, footY, logoS, logoS); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fff';
        ctx.font = '800 42px "Space Grotesk", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('H', PAD + logoS / 2, footY + logoS / 2 + 15);
        ctx.textAlign = 'left';

        // Site name + URL
        ctx.fillStyle = BORDER;
        ctx.font = '700 26px "Space Grotesk", sans-serif';
        ctx.fillText(siteName, PAD + logoS + 20, footY + 28);
        ctx.fillStyle = '#888';
        ctx.font = '400 22px Inter, sans-serif';
        ctx.fillText(siteUrl, PAD + logoS + 20, footY + 58);

        // QR code with black border frame
        const qrS = 100;
        const qrX = W - PAD - qrS - BW;
        const qrY = footY - 4;
        try {
          const { default: QRCode } = await import('https://esm.sh/qrcode@1.5.4' as any);
          const qrUrl: string = await QRCode.toDataURL(articleUrl, { width: 180, margin: 1, color: { dark: '#0A0A0A', light: '#fff' } });
          const qrImg = await loadImg(qrUrl);
          // QR border frame
          ctx.fillStyle = '#fff'; ctx.strokeStyle = BORDER; ctx.lineWidth = BW;
          ctx.beginPath(); ctx.rect(qrX - 6, qrY - 6, qrS + 12, qrS + 12); ctx.fill(); ctx.stroke();
          ctx.drawImage(qrImg, qrX, qrY, qrS, qrS);
        } catch {}

        // Scan text — follows footer bottom, not absolute H
        const scanY = footY + Math.max(logoS, qrS) + 40;
        ctx.fillStyle = '#999';
        ctx.font = '400 22px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(lblScan, W / 2, scanY);
        ctx.textAlign = 'left';
      }

      function downloadCard() {
        const canvas = document.getElementById('sc-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        const a = document.createElement('a');
        a.download = 'share-card.png';
        a.href = canvas.toDataURL('image/png');
        a.click();
      }

      function loadImg(src: string): Promise<HTMLImageElement> {
        return new Promise((res, rej) => {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => res(img);
          img.onerror = rej;
          img.src = src;
        });
      }

      function drawFallbackBg(ctx: CanvasRenderingContext2D, w: number, h: number) {
        const g = ctx.createLinearGradient(0, 0, w, h);
        g.addColorStop(0, '#1a1a2e'); g.addColorStop(1, '#0A0A0A');
        ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
      }

function wrapText(ctx: CanvasRenderingContext2D, text: string, maxW: number): string[] {
        const lines: string[] = [];
        let cur = '';
        for (const word of text.split(' ')) {
          const candidate = cur ? cur + ' ' + word : word;
          if (ctx.measureText(candidate).width <= maxW) {
            cur = candidate;
          } else {
            if (cur) { lines.push(cur); cur = ''; }
            for (const ch of word) {
              const t = cur + ch;
              if (ctx.measureText(t).width > maxW && cur) { lines.push(cur); cur = ch; }
              else cur = t;
            }
          }
        }
        if (cur) lines.push(cur);
        return lines;
      }
    })();

    // Lightbox
    (function () {
      const lb       = document.getElementById('lb') as HTMLElement;
      const lbImg    = document.getElementById('lb-img') as HTMLImageElement;
      const lbFrame  = document.getElementById('lb-frame') as HTMLElement;
      const lbPrev   = document.getElementById('lb-prev') as HTMLButtonElement;
      const lbNext   = document.getElementById('lb-next') as HTMLButtonElement;
      const lbClose  = document.getElementById('lb-close') as HTMLButtonElement;
      const lbCount  = document.getElementById('lb-counter') as HTMLElement;
      const lbHint   = document.getElementById('lb-zoom-hint') as HTMLElement;
      if (!lb) return;

      let imgs: HTMLImageElement[] = [];
      let cur = 0;

      // Zoom / pan state
      let scale = 1;
      let tx = 0, ty = 0;
      let dragging = false;
      let dragX = 0, dragY = 0;
      let hintTimer: ReturnType<typeof setTimeout> | null = null;

      function applyTransform() {
        lbImg.style.transform = `translate(${tx}px,${ty}px) scale(${scale})`;
        lbImg.style.cursor = scale > 1 ? (dragging ? 'grabbing' : 'grab') : 'default';
      }

      function resetZoom() { scale = 1; tx = 0; ty = 0; applyTransform(); }

      function showHint() {
        lbHint.textContent = Math.round(scale * 100) + '%';
        lbHint.classList.add('show');
        if (hintTimer) clearTimeout(hintTimer);
        hintTimer = setTimeout(() => lbHint.classList.remove('show'), 900);
      }

      function zoom(delta: number, cx: number, cy: number) {
        const prev = scale;
        scale = Math.min(Math.max(scale * delta, 1), 5);
        if (scale !== prev) {
          const r = delta - 1;
          const rect = lbFrame.getBoundingClientRect();
          tx += (cx - rect.left - rect.width  / 2 - tx) * r / (1 + r * scale / prev);
          ty += (cy - rect.top  - rect.height / 2 - ty) * r / (1 + r * scale / prev);
        }
        if (scale === 1) { tx = 0; ty = 0; }
        applyTransform();
        showHint();
      }

      // Wheel zoom
      lbFrame.addEventListener('wheel', (e) => {
        e.preventDefault();
        zoom(e.deltaY < 0 ? 1.15 : 1 / 1.15, e.clientX, e.clientY);
      }, { passive: false });

      // Drag pan
      lbImg.addEventListener('mousedown', (e) => {
        if (scale <= 1) return;
        dragging = true; dragX = e.clientX - tx; dragY = e.clientY - ty;
        applyTransform(); e.preventDefault();
      });
      window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        tx = e.clientX - dragX; ty = e.clientY - dragY; applyTransform();
      });
      window.addEventListener('mouseup', () => { dragging = false; applyTransform(); });

      // Double-click reset
      lbImg.addEventListener('dblclick', resetZoom);

      // Pinch zoom (touch)
      let lastPinch = 0;
      lbFrame.addEventListener('touchstart', (e) => {
        if (e.touches.length === 2)
          lastPinch = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      }, { passive: true });
      lbFrame.addEventListener('touchmove', (e) => {
        if (e.touches.length !== 2) return;
        e.preventDefault();
        const d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
        const cx = (e.touches[0].clientX + e.touches[1].clientX) / 2;
        const cy = (e.touches[0].clientY + e.touches[1].clientY) / 2;
        zoom(d / lastPinch, cx, cy); lastPinch = d;
      }, { passive: false });

      function show(i: number) {
        cur = (i + imgs.length) % imgs.length;
        lbImg.src = imgs[cur].src;
        lbImg.alt = imgs[cur].alt;
        lbCount.textContent = imgs.length > 1 ? `${cur + 1} / ${imgs.length}` : '';
        lbPrev.style.display = imgs.length > 1 ? '' : 'none';
        lbNext.style.display = imgs.length > 1 ? '' : 'none';
        resetZoom();
      }

      function open(i: number) {
        imgs = [...document.querySelectorAll<HTMLImageElement>('.post-content img')];
        lb.setAttribute('aria-hidden', 'false');
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
        show(i); lbClose.focus();
      }

      function close() {
        lb.setAttribute('aria-hidden', 'true');
        lb.classList.remove('open');
        document.body.style.overflow = '';
        resetZoom();
      }

      document.querySelectorAll<HTMLImageElement>('.post-content img').forEach((img, i) => {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', () => open(i));
      });

      lbPrev.addEventListener('click', () => show(cur - 1));
      lbNext.addEventListener('click', () => show(cur + 1));
      lbClose.addEventListener('click', close);
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape')     close();
        if (e.key === 'ArrowLeft')  show(cur - 1);
        if (e.key === 'ArrowRight') show(cur + 1);
        if (e.key === '0')          resetZoom();
      });
    })();
  </script>

  <div class="post-back-wrap">
    <a class="post-back" href={urlBase}>{t.blog.backToBlog}</a>
  </div>
</BaseLayout>

<style>
  .post-wrap {
    max-width: 880px;
