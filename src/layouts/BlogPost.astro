    cursor: default;
  }

  /* Callout boxes */
  .post-content :global(.callout) {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 14px 18px; margin: 28px 0;
    border: 2px solid #0A0A0A; border-radius: 12px;
    box-shadow: 4px 4px 0 #0A0A0A;
    font-style: normal; line-height: 1.6;
  }
  .post-content :global(.callout svg) { flex-shrink: 0; margin-top: 2px; }
  .post-content :global(.callout strong) { font-weight: 800; }
  .post-content :global(.callout-info)    { background: var(--blue);   color: #fff; }
  .post-content :global(.callout-warning) { background: var(--yellow); color: #0A0A0A; }
  .post-content :global(.callout-success) { background: var(--green);  color: #0A0A0A; }
