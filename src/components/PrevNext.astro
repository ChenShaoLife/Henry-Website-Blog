---
import { strings, type Lang } from '../i18n/strings';

type Adj = { id: string; title: string };
interface Props { lang: Lang; prev?: Adj | null; next?: Adj | null; }
const { lang, prev, next } = Astro.props;
const t = strings[lang];
const base = lang === 'en' ? '/blog' : '/zh/blog';
---
{(prev || next) && (
  <nav class="pn-wrap" aria-label="article navigation">
    {prev ? (
      <a class="pn-card pn-prev" href={`${base}/${prev.id}`}>
        <span class="pn-label">← {t.blog.prev}</span>
        <span class="pn-title">{prev.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a class="pn-card pn-next" href={`${base}/${next.id}`}>
        <span class="pn-label">{t.blog.next} →</span>
        <span class="pn-title">{next.title}</span>
      </a>
    ) : <span></span>}
  </nav>
)}

<style>
  .pn-wrap {
    max-width: 880px;
    margin: 32px auto 0;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pn-card {
    display: flex; flex-direction: column; gap: 6px;
    padding: 20px 24px;
    background: var(--surface);
    border: var(--bd); border-radius: 14px;
    box-shadow: var(--sh);
    text-decoration: none; color: inherit;
    transition: transform .2s var(--ease), box-shadow .2s var(--ease);
    min-width: 0;
  }
  .pn-card:hover { transform: translate(-2px,-2px); box-shadow: var(--sh-lg); }
  .pn-next { text-align: right; }
  .pn-label {
    font-family: var(--fh); font-size: 11px; font-weight: 700;
    color: var(--muted); letter-spacing: .08em; text-transform: uppercase;
  }
  .pn-title {
    font-family: var(--fh); font-size: 15px; font-weight: 700;
    line-height: 1.35;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical;
  }
  @media (max-width: 600px) {
    .pn-wrap { grid-template-columns: 1fr; padding: 0 12px; }
    .pn-next { text-align: left; }
  }
</style>
