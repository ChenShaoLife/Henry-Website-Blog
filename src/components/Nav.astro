---
import { strings, type Lang, otherLangPath } from '../i18n/strings';
interface Props { lang: Lang; langHref?: string; }
const { lang, langHref } = Astro.props;
const t = strings[lang];
const otherHref = langHref ?? otherLangPath(lang, Astro.url.pathname);
const homeBase = lang === 'en' ? '/' : '/zh/';
const blogBase = lang === 'en' ? '/blog' : '/zh/blog';
const isBlog = Astro.url.pathname.startsWith('/blog') || Astro.url.pathname.startsWith('/zh/blog');
---
<div class="nav-outer" role="navigation" aria-label={t.sections.navAria}>
  <nav class="nav-pill">
    <a href={`${homeBase}#hero`}     class={`nav-link${isBlog ? '' : ' active'}`}>{t.nav.home}
    <a href={`${homeBase}#videos`}   class="nav-link">{t.nav.videos}</a>
    <a href={`${homeBase}#projects`} class="nav-link">{t.nav.products}</a>
    <a href={blogBase}               class={`nav-link${isBlog ? ' active' : ''}`}>{t.nav.blog}</a>
    <a href={`${homeBase}#contact`}  class="nav-icon" aria-label={t.nav.emailAria}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </a>
    <a href={otherHref} class="nav-lang" aria-label={t.nav.toLangAria}>{t.nav.toLang}</a>
  </nav>
</div>
